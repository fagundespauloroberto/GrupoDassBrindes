unit uFrmCadastro;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ExtCtrls;

type
  TFrmCadastro = class(TForm)
    Panel1: TPanel;
    Label1: TLabel;
    Label3: TLabel;
    EdtNome: TEdit;
    ID: TLabel;
    EdtID: TEdit;
    EdtEmail: TEdit;
    Label4: TLabel;
    Panel2: TPanel;
    BtnSalvar: TButton;
    BtnCancelar: TButton;
    Label5: TLabel;
    Label6: TLabel;
    EdtTamanhoCalcado: TEdit;
    CbTamanhoCamiseta: TComboBox;
    EdtCPF: TEdit;
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure BtnSalvarClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FrmCadastro: TFrmCadastro;

implementation

{$R *.dfm}

procedure TFrmCadastro.BtnSalvarClick(Sender: TObject);
var
  Funcionario: TFuncionario;
  Erro: string;
begin
  if not ValidarCampos then
    Exit;

  Funcionario := TFuncionario.Create;
  try
    Funcionario.ID := StrToIntDef(EdtID.Text, 0);
    Funcionario.CPF := Trim(EdtCPF.Text);
    Funcionario.Nome := Trim(EdtNome.Text);
    Funcionario.Email := Trim(EdtEmail.Text);
    Funcionario.TamanhoCamiseta := CbTamanhoCamiseta.Text;
    Funcionario.TamanhoCalcado := StrToInt(EdtTamanhoCalcado.Text);

    if FController.Salvar(Funcionario, Erro) then
    begin
      ShowMessage('Funcionário salvo com sucesso!');
      ModalResult := mrOk;
    end
    else
    begin
      MessageDlg('Erro ao salvar no banco de dados: ' + Erro, mtError, [mbOK], 0);
    end;
  finally
    Funcionario.Free;
  end;
end;

procedure TFrmCadastro.FormCreate(Sender: TObject);
begin
  FController := TFuncionarioController.Create;
  LimparCampos;
end;

procedure TFrmCadastro.FormDestroy(Sender: TObject);
begin
  FController.Free;
end;

end.
