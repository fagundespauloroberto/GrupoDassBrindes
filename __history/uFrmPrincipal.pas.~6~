unit uFrmPrincipal;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, ActnList, Menus, ComCtrls, ExtCtrls;

type
  TFormPrincipal = class(TForm)
    MainMenu1: TMainMenu;
    Cadastros1: TMenuItem;
    MenuFuncionarios: TMenuItem;
    Ajuda1: TMenuItem;
    MenuSobre: TMenuItem;
    MenuSair: TMenuItem;
    ActionList1: TActionList;
    procedure MenuFuncionariosClick(Sender: TObject);
    procedure MenuSairClick(Sender: TObject);
    procedure MenuSobreClick(Sender: TObject);
    procedure FormShow(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  FormPrincipal: TFormPrincipal;

implementation

{$R *.dfm}

{ TFormPrincipal }

procedure TFormPrincipal.FormShow(Sender: TObject);
begin
  // Atualiza a barra de status com informacoes do sistema
  StatusBar1.Panels[0].Text := ' Sistema Dass Brindes v1.0';
  StatusBar1.Panels[1].Text := ' Status: Conectado ao Banco Firebird';
end;

procedure TFormPrincipal.MenuFuncionariosClick(Sender: TObject);
var
  FrmConsulta: TFrmConsulta;
begin
  // Instancia e abre a tela de consulta de forma controlada
  FrmConsulta := TFrmConsulta.Create(Self);
  try
    FrmConsulta.ShowModal;
  finally
    FrmConsulta.Free;
  end;
end;

procedure TFormPrincipal.MenuSobreClick(Sender: TObject);
begin
  ShowMessage('Grupo Dass - Gestão de Brindes de Funcionários' + sLineBreak +
              'Desenvolvido em Delphi 2010 + Firebird (MVC)');
end;

procedure TFormPrincipal.MenuSairClick(Sender: TObject);
begin
  Close;
end;

end.
